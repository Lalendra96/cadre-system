APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# Set true when the application is served over HTTPS.
SESSION_SECURE_COOKIE=false

PASSWORD_MAX_AGE_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
MFA_REQUIRED_ROLES=super_admin,admin_group
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_SECONDS=300
# Enable only after ClamAV (or compatible clamscan binary) is installed on the server.
UPLOAD_SCAN_ENABLED=false
UPLOAD_SCANNER_COMMAND=/usr/bin/clamscan
UPLOAD_REJECT_DOUBLE_EXTENSIONS=true
SECURITY_LOG_DAYS=90

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Personnel PII protection (generate with: php artisan pii:generate-keys)
PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=
PII_SEARCH_KEY=
PII_CIPHER=AES-256-CBC

# Client Version & Feature Manager seed account
# A strong temporary password is REQUIRED when APP_ENV=production.
FEATURE_MANAGER_SEED_NAME="Client Feature Manager"
FEATURE_MANAGER_SEED_EMAIL="feature.manager@hims.local"
FEATURE_MANAGER_SEED_PASSWORD=
