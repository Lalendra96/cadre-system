{
    "name": "pariksha/carder-hr-responsibility-tests",
    "description": "Isolated Laravel 12 regression harness; application code targets Laravel 10 APIs",
    "type": "project",
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "../../app/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php HrResponsibilityTest.php"
    },
    "config": {
        "allow-plugins": false
    }
}
